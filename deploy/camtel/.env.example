# ============================================================
# SIA-ANSAR — variables pour déploiement Camtel
# Copier vers deploy/camtel/.env et renseigner les valeurs.
# ============================================================

# Port HTTP exposé sur le VPS (80 par défaut)
HTTP_PORT=80

# URL publique du site (CORS). Ex. http://IP_DU_VPS ou https://ansar.mondomaine.cm
FRONTEND_URL=http://localhost

# Origines CORS supplémentaires (virgules), optionnel
# ADDITIONAL_CORS_ORIGINS=https://www.mondomaine.cm

# ------------------------------------------------------------
# Base de données — CHOISIR UNE OPTION
# ------------------------------------------------------------

# Option A — garder Supabase (recommandé pour démarrer)
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-....pooler.supabase.com:6543/postgres

# Option B — Postgres dans Docker (--profile with-db)
# DATABASE_URL=postgresql://ansar:MOT_DE_PASSE_FORT@db:5432/truck_track
# POSTGRES_USER=ansar
# POSTGRES_PASSWORD=MOT_DE_PASSE_FORT
# POSTGRES_DB=truck_track

DATABASE_URL=

# true uniquement au 1er démarrage si les tables n’existent pas encore
DB_SYNCHRONIZE=false
