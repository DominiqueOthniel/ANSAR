# ============================================================
# SIA-ANSAR — Full VPS Camtel (front + API + Postgres sur le VPS)
# Copier vers deploy/camtel/.env et renseigner les valeurs.
# ============================================================

HTTP_PORT=80

# URL publique (CORS). Ex. http://IP_DU_VPS ou https://ansar.mondomaine.cm
FRONTEND_URL=http://localhost

# Origines CORS supplémentaires (virgules), optionnel
# ADDITIONAL_CORS_ORIGINS=https://www.mondomaine.cm

# ------------------------------------------------------------
# Full VPS = Postgres dans Docker (recommandé)
# ------------------------------------------------------------
DATABASE_URL=postgresql://ansar:CHANGE_ME_STRONG_PASSWORD@db:5432/truck_track
POSTGRES_USER=ansar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=truck_track

# true au 1er démarrage seulement, puis false
DB_SYNCHRONIZE=true

# ------------------------------------------------------------
# Alternative : garder Supabase (pas full VPS)
# ------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-….pooler.supabase.com:6543/postgres
# (alors ne pas renseigner POSTGRES_* et ne pas utiliser @db)
